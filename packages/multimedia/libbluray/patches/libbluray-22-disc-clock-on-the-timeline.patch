     return 1;
 }
 
+/* System.setProperty(key, value); exceptions are logged and cleared */
+static void _bdj_set_property(JNIEnv *env, const char *key, const char *value)
+{
+    jclass sys_class;
+    jmethodID set_id;
+
+    if (!_get_method(env, &sys_class, &set_id,
+                     "java/lang/System", "setProperty",
+                     "(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;")) {
+        return;
+    }
+
+    jstring jkey = (*env)->NewStringUTF(env, key);
+    jstring jval = (*env)->NewStringUTF(env, value);
+    if (jkey && jval) {
+        jobject old = (*env)->CallStaticObjectMethod(env, sys_class, set_id, jkey, jval);
+        if (old) {
+            (*env)->DeleteLocalRef(env, old);
+        }
+    }
+    if ((*env)->ExceptionOccurred(env)) {
+        (*env)->ExceptionDescribe(env);
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "Failed to set property %s\n", key);
+        (*env)->ExceptionClear(env);
+    }
+
+    if (jkey) {
+        (*env)->DeleteLocalRef(env, jkey);
+    }
+    if (jval) {
+        (*env)->DeleteLocalRef(env, jval);
+    }
+    (*env)->DeleteLocalRef(env, sys_class);
+}
+
 static int _bdj_init(JNIEnv *env, struct bluray *bd, const char *disc_root, const char *bdj_disc_id,
                      BDJ_CONFIG *storage)
 {
@@ -774,6 +810,15 @@ static int _bdj_init(JNIEnv *env, struct bluray *bd, const char *disc_root, cons
         BD_DEBUG(DBG_BDJ | DBG_CRIT, "Couldn't register native methods.\n");
     }
 
+    /* disc time off switch, set on every BD-J start before any xlet
+     * context exists (the JVM is shared by later discs, so not a -D) */
+    {
+        int off = disc_clock_off();
+        _bdj_set_property(env, "bluray.disctime.off", off ? "true" : "false");
+        /* DISCDIAG TEMP */
+        BD_DEBUG(DBG_BDJ | DBG_CRIT, "DISCDIAG TEMP bluray.disctime.off=%s\n", off ? "true" : "false");
+    }
+
     // initialize class org.videolan.Libbluray
