+
+/*
+ * Disc time (phase 5, step 5.D).
+ *
+ * One process-lifetime clock: one disc plays at a time, and lingering
+ * xlet threads may read it after bd_close(), so it lives in static
+ * storage, not in the BLURAY object.
+ *
+ * disc ns is defined from the first use in the process and never goes
+ * back: a disc start records the disc ns and the wall time at that
+ * instant (for millis) but does not reset the disc ns.
+ *
+ * The value at CLOCK_MONOTONIC instant t is
+ *     anchor_disc + (running ? max(0, t - anchor_mono) : 0)
+ * so a run anchor in the future keeps disc time frozen until that
+ * instant and starts it exactly there.
+ *
+ * Every write also records a segment {from_mono, anchor_mono, anchor_disc,
+ * running} in a ring of the last DC_SEGMENTS (from_mono = the write's
+ * instant), so disc_time_at(t) for an instant before the latest write is
+ * evaluated against the segment that was in force at t (the latest whose
+ * from_mono <= t). Instants older than the ring use the oldest segment
+ * (counted, DISCDIAG).
+ *
+ * Locking rule: the clock mutex guards a copy of a few words only.
+ * Nothing calls into Java, logs, or takes another lock while holding it
+ * (readers include every xlet thread and the graphics controller under
+ * bd->mutex; the writer is the player's leaf owner).
+ */
+
+#if defined(_WIN32)
+static SRWLOCK _dc_lock = SRWLOCK_INIT;
+#  define DC_LOCK()   AcquireSRWLockExclusive(&_dc_lock)
+#  define DC_UNLOCK() ReleaseSRWLockExclusive(&_dc_lock)
+
+static int64_t _mono_ns(void)
+{
+    LARGE_INTEGER frequency, counter;
+    QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&counter);
+    return (int64_t)((double)counter.QuadPart * 1e9 / (double)frequency.QuadPart);
+}
+
+static int64_t _wall_ms(void)
+{
+    FILETIME ft;
+    GetSystemTimeAsFileTime(&ft);
+    uint64_t t = ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    return (int64_t)(t / 10000) - INT64_C(11644473600000);
+}
+#else
+#  include <pthread.h>
+#  include <time.h>
+static pthread_mutex_t _dc_lock = PTHREAD_MUTEX_INITIALIZER;
+#  define DC_LOCK()   pthread_mutex_lock(&_dc_lock)
+#  define DC_UNLOCK() pthread_mutex_unlock(&_dc_lock)
+
+static int64_t _mono_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * INT64_C(1000000000) + ts.tv_nsec;
+}
+
+static int64_t _wall_ms(void)
+{
+    struct timeval tv;
+    gettimeofday(&tv, 0);
+    return (int64_t)tv.tv_sec * 1000 + tv.tv_usec / 1000;
+}
+#endif
+
+#define DC_SEGMENTS 8
+
+typedef struct {
+    int64_t from_mono_ns;           /* in force from this instant (the write) */
+    int64_t anchor_mono_ns;
+    int64_t anchor_disc_ns;
+    int     running;
+} DC_SEGMENT;
+
+static struct {
+    int      initialized;
+    int      running;
+    int      off;                   /* disctime_off: never freezes */
+    uint32_t generation;            /* bumped at every write */
+    int64_t  anchor_mono_ns;        /* CLOCK_MONOTONIC */
+    int64_t  anchor_disc_ns;
+    int64_t  disc_ns_at_disc_start;
+    int64_t  wall_ms_at_disc_start;
+
+    DC_SEGMENT seg[DC_SEGMENTS];    /* ring, seg[seg_head] = the current one */
+    unsigned   seg_head;
+    unsigned   seg_count;
+    uint32_t   older_than_ring;     /* DISCDIAG TEMP: disc_time_at() before the ring */
+} _dc;
+
+/* call with the clock mutex held, after every write of the anchor */
+static void _dc_push_locked(int64_t from_mono_ns)
+{
+    DC_SEGMENT *s;
+
+    if (_dc.seg_count) {
+        _dc.seg_head = (_dc.seg_head + 1) % DC_SEGMENTS;
+    }
+    if (_dc.seg_count < DC_SEGMENTS) {
+        _dc.seg_count++;
+    }
+    s = &_dc.seg[_dc.seg_head];
+    s->from_mono_ns   = from_mono_ns;
+    s->anchor_mono_ns = _dc.anchor_mono_ns;
+    s->anchor_disc_ns = _dc.anchor_disc_ns;
+    s->running        = _dc.running;
+}
+
+static int64_t _dc_seg_value(const DC_SEGMENT *s, int64_t mono_ns)
+{
+    int64_t d;
+
+    if (!s->running) {
+        return s->anchor_disc_ns;
+    }
+    d = mono_ns - s->anchor_mono_ns;
+    return s->anchor_disc_ns + (d > 0 ? d : 0);
+}
+
+/* call with the clock mutex held: the value at an instant, past ones
+ * against the segment in force then; *older set when before the ring */
+static int64_t _dc_value_at_locked(int64_t mono_ns, int *older)
+{
+    unsigned i, idx = _dc.seg_head;
+
+    for (i = 0; i < _dc.seg_count; i++) {
+        idx = (_dc.seg_head + DC_SEGMENTS - i) % DC_SEGMENTS;
+        if (_dc.seg[idx].from_mono_ns <= mono_ns) {
+            return _dc_seg_value(&_dc.seg[idx], mono_ns);
+        }
+    }
+    /* before the oldest segment: use it */
+    *older = 1;
+    return _dc_seg_value(&_dc.seg[idx], mono_ns);
+}
+
+/* call with the clock mutex held */
+static void _dc_init_locked(int64_t now)
+{
+    if (!_dc.initialized) {
+        _dc.initialized           = 1;
+        _dc.running               = 1;
+        _dc.anchor_mono_ns        = now;
+        _dc.anchor_disc_ns        = 0;
+        _dc.disc_ns_at_disc_start = 0;
+        _dc.wall_ms_at_disc_start = _wall_ms();
+        _dc_push_locked(now);
+    }
+}
+
+/* call with the clock mutex held */
+static int64_t _dc_value_locked(int64_t mono_ns)
+{
+    int64_t d;
+
+    if (!_dc.running) {
+        return _dc.anchor_disc_ns;
+    }
+    d = mono_ns - _dc.anchor_mono_ns;
+    return _dc.anchor_disc_ns + (d > 0 ? d : 0);
+}
+
+int64_t disc_clock_mono_ns(void)
+{
+    return _mono_ns();
+}
+
+void disc_clock_start(void)
+{
+    int64_t now  = _mono_ns();
+    int64_t wall = _wall_ms();
+    int64_t v, cur_ms, wall_start;
+    int     was_running, off;
+    uint32_t gen;
+
+    DC_LOCK();
+    _dc_init_locked(now);
+    was_running = _dc.running;
+    v = _dc_value_locked(now);
+    /* millis never go back across discs, even with the wall clock
+     * stepped back between them */
+    cur_ms = _dc.wall_ms_at_disc_start + (v - _dc.disc_ns_at_disc_start) / 1000000;
+    wall_start = wall > cur_ms ? wall : cur_ms;
+    _dc.anchor_disc_ns        = v;
+    _dc.anchor_mono_ns        = now;
+    _dc.running               = 1;
+    _dc.disc_ns_at_disc_start = v;
+    _dc.wall_ms_at_disc_start = wall_start;
+    _dc_push_locked(now);
+    gen = ++_dc.generation;
+    off = _dc.off;
+    DC_UNLOCK();
+
+    /* DISCDIAG TEMP */
+    BD_DEBUG(DBG_BLURAY | DBG_CRIT,
+             "DISCDIAG TEMP start: disc=%" PRId64 " ms wall=%" PRId64 " ms millis_start=%" PRId64 " ms was_running=%d off=%d gen=%u\n",
+             v / 1000000, wall, wall_start, was_running, off, (unsigned)gen);
+}
+
+void disc_clock_set(int running, int64_t at_mono_ns)
+{
+    int64_t now = _mono_ns();
+    int64_t at  = at_mono_ns > 0 ? at_mono_ns : now;
+    int64_t v, eff = now;
+    int     was_running, ignored = 0;
+    uint32_t gen;
+
+    DC_LOCK();
+    _dc_init_locked(now);
+    was_running = _dc.running;
+    v = _dc_value_locked(now);
+    if (!running && _dc.off) {
+        ignored = 1;
+    } else if (!running) {
+        /* a freeze is at now: never back-dated, never in the future */
+        _dc.anchor_disc_ns = v;
+        _dc.anchor_mono_ns = now;
+        _dc.running        = 0;
+    } else {
+        /* a run anchor is never in the past (that would erase a freeze) */
+        eff = at > now ? at : now;
+        _dc.anchor_disc_ns = v;
+        _dc.anchor_mono_ns = eff;
+        _dc.running        = 1;
+    }
+    if (!ignored) {
+        _dc_push_locked(now);
+    }
+    gen = ignored ? _dc.generation : ++_dc.generation;
+    DC_UNLOCK();
+
+    /* DISCDIAG TEMP */
+    BD_DEBUG(DBG_BLURAY | DBG_CRIT,
+             "DISCDIAG TEMP set: %s at %+" PRId64 " us from now (asked %+" PRId64 "), disc=%" PRId64 " ms was_running=%d%s gen=%u\n",
+             running ? "RUN" : "FREEZE", (eff - now) / 1000, (at - now) / 1000, v / 1000000, was_running,
+             ignored ? " IGNORED(off)" : "", (unsigned)gen);
+}
+
+void disc_clock_set_off(int off)
+{
+    int changed;
+
+    DC_LOCK();
+    changed = _dc.off != !!off;
+    _dc.off = !!off;
+    if (_dc.off && _dc.initialized && !_dc.running) {
+        /* off never freezes: resume at now */
+        int64_t now = _mono_ns();
+        _dc.anchor_disc_ns = _dc_value_locked(now);
+        _dc.anchor_mono_ns = now;
+        _dc.running        = 1;
+        _dc_push_locked(now);
+        _dc.generation++;
+    }
+    DC_UNLOCK();
+
+    if (changed) {
+        /* DISCDIAG TEMP */
+        BD_DEBUG(DBG_BLURAY | DBG_CRIT, "DISCDIAG TEMP off=%d\n", !!off);
+    }
+}
+
+int disc_clock_off(void)
+{
+    int off;
+
+    DC_LOCK();
+    off = _dc.off;
+    DC_UNLOCK();
+
+    return off;
+}
+
+int64_t disc_time_at(int64_t mono_ns)
+{
+    int64_t v;
+    int     older = 0;
+    uint32_t n = 0;
+
+    DC_LOCK();
+    _dc_init_locked(_mono_ns());
+    v = _dc_value_at_locked(mono_ns, &older);
+    if (older) {
+        n = ++_dc.older_than_ring;
+    }
+    DC_UNLOCK();
+
+    if (older) {
+        /* DISCDIAG TEMP */
+        BD_DEBUG(DBG_BLURAY | DBG_CRIT,
+                 "DISCDIAG TEMP disc_time_at: instant older than the last %d clock writes, oldest segment used (count %u)\n",
+                 DC_SEGMENTS, (unsigned)n);
+    }
+    return v;
+}
+
+int64_t disc_time_ns(void)
+{
+    int64_t now = _mono_ns();
+    int64_t v;
+
+    DC_LOCK();
+    _dc_init_locked(now);
+    v = _dc_value_locked(now);
+    DC_UNLOCK();
+
+    return v;
+}
+
+int64_t disc_time_millis(void)
+{
+    int64_t now = _mono_ns();
+    int64_t ms;
+
+    DC_LOCK();
+    _dc_init_locked(now);
+    ms = _dc.wall_ms_at_disc_start +
+         (_dc_value_locked(now) - _dc.disc_ns_at_disc_start) / 1000000;
+    DC_UNLOCK();
+
+    return ms;
+}
+
+uint64_t disc_time_90k(void)
+{
+    if (disc_clock_off()) {
+        return bd_get_scr();
+    }
+    return (uint64_t)(disc_time_ns() / 100000) * 9;
+}
