+package org.videolan;
+
+/*
+ * Disc time (phase 5): the time a disc reads.
+ *
+ * Disc time runs at 1x, except while the player freezes it for an output
+ * change (a mode set, a held start); it never goes back. The clock lives in
+ * libbluray C (Libbluray.discTime*), process-wide.
+ *
+ * The helpers below replace the JDK time sources a disc uses. They keep the
+ * JDK 8u462 argument checks and exceptions: IllegalArgumentException before
+ * any monitor is touched, IllegalMonitorStateException and
+ * InterruptedException from the JDK wait/sleep itself (interrupt status
+ * cleared when thrown), wait(0,0) / join(0) / sleep(0) passed through.
+ *
+ * Waits run on wall time towards the disc deadline: while disc time runs
+ * one wall wait covers the remaining disc time; a wall wait that ends with
+ * disc time short (frozen) waits again, in slices of min(remaining, 50) ms
+ * only while frozen. A remainder that rounds to 0 ms waits 1 ms (never a
+ * wait(0)); deadlines saturate at Long.MAX_VALUE.
+ *
+ * waitOn: an early wake (notify, interrupt-free spurious wake) returns at
+ * once, as Object.wait does. A notify that coincides with the wall timeout
+ * during a freeze is indistinguishable from the timeout (inherent to
+ * wait(J)); the helper waits again and that notify is lost until the disc
+ * deadline. Counted in DISCDIAG.
+ *
+ * Off (bluray.disctime.off, set by libbluray before Libbluray.init): every
+ * helper is the JDK call it replaces.
+ */
+public final class DiscTime {
+
+    private DiscTime() {
+    }
+
+    /* off flag: read at class init and again at every Libbluray.init (the
+     * JVM is shared by later discs) */
+    private static volatile boolean off = Libbluray.discTimeOff();
+
+    static void init() {
+        diagReport("before disc start", true);
+        synchronized (diagLock) {
+            for (int i = 0; i < D_COUNT; i++)
+                diagCounts[i] = 0;
+            diagDirty = false;
+        }
+        off = Libbluray.discTimeOff();
+    }
+
+    public static boolean isOff() {
+        return off;
+    }
+
+    /* slice length while frozen (ms) */
+    private static final long FROZEN_SLICE_MS = 50;
+    /* disc time that fell behind wall time by more than this over one wall
+     * wait was frozen during it */
+    private static final long FROZEN_TOLERANCE_NS = 1000000L;
+
+    /*
+     * time sources
+     */
+
+    /* no synchronized: the native's pthread mutex is a full barrier, which
+     * is what the Evangelion fix (System.currentTimeMillisSynced) needed */
+    public static long currentTimeMillis() {
+        if (off)
+            return System.currentTimeMillis();
+        return Libbluray.discTimeMillis();
+    }
+
+    public static long nanoTime() {
+        if (off)
+            return System.nanoTime();
+        return Libbluray.discTimeNanos();
+    }
+
+    /*
+     * Thread.sleep
+     */
+
+    public static void sleep(long millis) throws InterruptedException {
+        if (millis < 0) {
+            throw new IllegalArgumentException("timeout value is negative");
+        }
+        if (off || millis == 0) {
+            Thread.sleep(millis);
+            return;
+        }
+
+        diagCount(D_SLEEP_CALLS);
+
+        long deadline = deadlineNs(Libbluray.discTimeNanos(), millis);
+        long waitMs = millis;
+        boolean extended = false;
+
+        while (true) {
+            long wall0 = System.nanoTime();
+            long disc0 = Libbluray.discTimeNanos();
+            Thread.sleep(waitMs);
+            long disc1 = Libbluray.discTimeNanos();
+            long wall1 = System.nanoTime();
+
+            long remaining = deadline - disc1;
+            if (remaining <= 0) {
+                break;
+            }
+            /* disc time short: frozen during this sleep, or it ran short of
+             * the wall wait (frozen until a future run instant) */
+            if (!extended) {
+                extended = true;
+                diagCount(D_SLEEP_FROZEN_WAITS);
+            }
+            diagCount(D_SLEEP_FROZEN_SLICES);
+            waitMs = nextWaitMs(remaining, frozenDuring(wall0, wall1, disc0, disc1));
+        }
+
+        diagMaybeReport();
+    }
+
+    /* JDK 8u462 Thread.sleep(JI) prologue */
+    public static void sleep(long millis, int nanos) throws InterruptedException {
+        if (millis < 0) {
+            throw new IllegalArgumentException("timeout value is negative");
+        }
+        if (nanos < 0 || nanos > 999999) {
+            throw new IllegalArgumentException("nanosecond timeout value out of range");
+        }
+        if (nanos >= 500000 || (nanos != 0 && millis == 0)) {
+            millis++;
+        }
+        sleep(millis);
+    }
+
+    /*
+     * Object.wait
+     */
+
+    public static void waitOn(Object obj, long timeout) throws InterruptedException {
+        if (obj == null) {
+            /* invokevirtual on null: NullPointerException before anything */
+            throw new NullPointerException();
+        }
+        if (timeout < 0) {
+            throw new IllegalArgumentException("timeout value is negative");
+        }
+        if (off || timeout == 0) {
+            obj.wait(timeout);
+            return;
+        }
+
+        /* the first monitor-sensitive operation is obj.wait itself, so
+         * IllegalMonitorStateException comes from the JDK as before */
+        long deadline = deadlineNs(Libbluray.discTimeNanos(), timeout);
+        long waitMs = timeout;
+        boolean rewaited = false;
+
+        while (true) {
+            long wall0 = System.nanoTime();
+            long disc0 = Libbluray.discTimeNanos();
+            obj.wait(waitMs);
+            long disc1 = Libbluray.discTimeNanos();
+            long wall1 = System.nanoTime();
+
+            if (wall1 - wall0 < msToNs(waitMs)) {
+                /* woken before the wall timeout: notify or spurious wake */
+                diagCount(D_WAIT_EARLY);
+                break;
+            }
+            long remaining = deadline - disc1;
+            if (remaining <= 0) {
+                diagCount(rewaited ? D_WAIT_TIMEOUT_AFTER_FREEZE : D_WAIT_TIMEOUT);
+                break;
+            }
+            /* wall timeout with disc time short: frozen, wait again */
+            rewaited = true;
+            diagCount(D_WAIT_REWAITS);
+            waitMs = nextWaitMs(remaining, frozenDuring(wall0, wall1, disc0, disc1));
+        }
+
+        diagMaybeReport();
+    }
+
+    /* JDK 8u462 Object.wait(JI) prologue */
+    public static void waitOn(Object obj, long timeout, int nanos) throws InterruptedException {
+        if (obj == null) {
+            throw new NullPointerException();
+        }
+        if (timeout < 0) {
+            throw new IllegalArgumentException("timeout value is negative");
+        }
+        if (nanos < 0 || nanos > 999999) {
+            throw new IllegalArgumentException("nanosecond timeout value out of range");
+        }
+        if (nanos > 0) {
+            timeout++;
+        }
+        waitOn(obj, timeout);
+    }
+
+    /*
+     * Thread.join
+     */
+
+    public static void joinOn(Thread thread, long millis) throws InterruptedException {
+        if (thread == null) {
+            throw new NullPointerException();
+        }
+        if (millis < 0) {
+            throw new IllegalArgumentException("timeout value is negative");
+        }
+        if (off || millis == 0) {
+            thread.join(millis);
+            return;
+        }
+
+        diagCount(D_JOIN_CALLS);
+
+        /* as Thread.join(J): wait on the thread, which notifies all at its
+         * exit; loop until it is dead or the disc deadline passed */
+        synchronized (thread) {
+            long deadline = deadlineNs(Libbluray.discTimeNanos(), millis);
+            boolean frozen = false;
+            boolean extended = false;
+            while (thread.isAlive()) {
+                long disc0 = Libbluray.discTimeNanos();
+                long remaining = deadline - disc0;
+                if (remaining <= 0) {
+                    break;
+                }
+                long waitMs = nextWaitMs(remaining, frozen);
+                long wall0 = System.nanoTime();
+                thread.wait(waitMs);
+                long disc1 = Libbluray.discTimeNanos();
+                long wall1 = System.nanoTime();
+                frozen = frozenDuring(wall0, wall1, disc0, disc1);
+                if (frozen && !extended) {
+                    extended = true;
+                    diagCount(D_JOIN_FROZEN_WAITS);
+                }
+            }
+        }
+
+        diagMaybeReport();
+    }
+
+    /* JDK 8u462 Thread.join(JI) prologue */
+    public static void joinOn(Thread thread, long millis, int nanos) throws InterruptedException {
+        if (thread == null) {
+            throw new NullPointerException();
+        }
+        if (millis < 0) {
+            throw new IllegalArgumentException("timeout value is negative");
+        }
+        if (nanos < 0 || nanos > 999999) {
+            throw new IllegalArgumentException("nanosecond timeout value out of range");
+        }
+        if (nanos >= 500000 || (nanos != 0 && millis == 0)) {
+            millis++;
+        }
+        joinOn(thread, millis);
+    }
+
+    /*
+     * arithmetic (saturating)
+     */
+
+    static long msToNs(long ms) {
+        if (ms >= Long.MAX_VALUE / 1000000L)
+            return Long.MAX_VALUE;
+        return ms * 1000000L;
+    }
+
+    static long deadlineNs(long nowNs, long ms) {
+        long ns = msToNs(ms);
+        if (nowNs > 0 && ns > Long.MAX_VALUE - nowNs)
+            return Long.MAX_VALUE;
+        return nowNs + ns;
+    }
+
+    /* remaining ns (> 0) to a wall wait in ms: rounded up, so never 0 */
+    static long ceilMs(long ns) {
+        long ms = ns / 1000000L;
+        if (ns % 1000000L != 0)
+            ms++;
+        return ms < 1 ? 1 : ms;
+    }
+
+    static long nextWaitMs(long remainingNs, boolean frozen) {
+        long ms = ceilMs(remainingNs);
+        if (frozen && ms > FROZEN_SLICE_MS)
+            ms = FROZEN_SLICE_MS;
+        return ms;
+    }
+
+    /* disc time advanced less than wall time over [wall0, wall1] */
+    static boolean frozenDuring(long wall0, long wall1, long disc0, long disc1) {
+        return (wall1 - wall0) - (disc1 - disc0) > FROZEN_TOLERANCE_NS;
+    }
+
+    /*
+     * DISCDIAG TEMP: counters per kind, logged at most once per 10 s and at
+     * xlet shutdown. Never counted on the time-source hot paths.
+     */
+
+    static final int D_SLEEP_CALLS               = 0;
+    static final int D_SLEEP_FROZEN_WAITS        = 1;  /* sleeps that waited past their wall time */
+    static final int D_SLEEP_FROZEN_SLICES       = 2;  /* extra wall sleeps for those */
+    static final int D_WAIT_EARLY                = 3;  /* waitOn returned on notify / spurious wake */
+    static final int D_WAIT_TIMEOUT              = 4;  /* waitOn timed out with disc time running */
+    static final int D_WAIT_REWAITS              = 5;  /* waitOn wall timeouts that found disc time short */
+    static final int D_WAIT_TIMEOUT_AFTER_FREEZE = 6;  /* waitOn timeouts reached only after a re-wait */
+    static final int D_JOIN_CALLS                = 7;
+    static final int D_JOIN_FROZEN_WAITS         = 8;
+    static final int D_TIMER_FIRINGS             = 9;  /* DiscTimer task runs */
+    static final int D_TIMER_FROZEN_RECHECKS     = 10; /* DiscTimer queue waits that found disc time frozen */
+    private static final int D_COUNT             = 11;
+
+    private static final String[] D_NAMES = {
+        "sleep", "sleep_frozen", "sleep_slices",
+        "wait_early", "wait_timeout", "wait_rewait", "wait_timeout_after_freeze",
+        "join", "join_frozen",
+        "timer_fired", "timer_frozen_recheck",
+    };
+
+    private static final Object diagLock = new Object();
+    private static final long[] diagCounts = new long[D_COUNT];
+    private static long diagLastNs = System.nanoTime();
+    private static boolean diagDirty = false;
+    private static final long DIAG_PERIOD_NS = 10000000000L;
+
+    static void diagCount(int kind) {
+        synchronized (diagLock) {
+            diagCounts[kind]++;
+            diagDirty = true;
+        }
+    }
+
+    /* call with no lock of ours held */
+    static void diagMaybeReport() {
+        diagReport(null, false);
+    }
+
+    /* xlet shutdown / disc start: report now if anything changed */
+    public static void diagReport(String why) {
+        diagReport(why, true);
+    }
+
+    private static void diagReport(String why, boolean force) {
+        String msg;
+        synchronized (diagLock) {
+            long now = System.nanoTime();
+            if (!diagDirty)
+                return;
+            if (!force && now - diagLastNs < DIAG_PERIOD_NS)
+                return;
+            diagLastNs = now;
+            diagDirty = false;
+            StringBuffer sb = new StringBuffer("DISCDIAG TEMP disc time");
+            if (why != null)
+                sb.append(" (").append(why).append(")");
+            sb.append(off ? " off:" : ":");
+            for (int i = 0; i < D_COUNT; i++)
+                sb.append(' ').append(D_NAMES[i]).append('=').append(diagCounts[i]);
+            msg = sb.toString();
+        }
+        logger.info(msg);
+    }
+
+    private static final Logger logger = Logger.getLogger(DiscTime.class.getName());
+}
