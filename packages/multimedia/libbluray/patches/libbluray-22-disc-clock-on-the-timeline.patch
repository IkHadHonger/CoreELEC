+ * <http://www.gnu.org/licenses/>.
+ */
+
+package org.videolan;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.JarURLConnection;
+import java.net.URL;
+import java.net.URLConnection;
+import java.security.AccessController;
+import java.security.CodeSigner;
+import java.security.CodeSource;
+import java.security.PrivilegedAction;
+import java.security.PrivilegedActionException;
+import java.security.PrivilegedExceptionAction;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.jar.Attributes;
+import java.util.jar.JarEntry;
+import java.util.jar.JarFile;
+import java.util.jar.Manifest;
+
+/*
+ * Disc time (phase 5): the one define path for every disc class of a loader
+ * (BDJClassLoader, DVBClassLoader's URLClassLoader) while disc time is on.
+ *
+ * Patched, unchanged and stripped classes are all defined the same way, as
+ * URLClassLoader does: the 5-argument defineClass with a CodeSource of the
+ * classpath jar URL (JarURLConnection.getJarFileURL()) and the entry's code
+ * signers (read after the entry was read to EOF), and definePackage from
+ * the jar manifest with URLClassLoader's sealing check. Directory
+ * AppCaches: the directory URL, no signers, no manifest.
+ *
+ * A class the patcher cannot parse is defined unpatched with an ERROR;
+ * one whose constant pool names the Timer types fails (ERROR naming it),
+ * since an unremapped class next to remapped ones would give LinkageError.
+ * A ClassFormatError from defineClass retries once with debug info
+ * stripped (BDJClassFileTransformer.strip), patched again.
+ *
+ * The loader implements the hooks; the definer calls them only from
+ * findClass (the loader's lock is held: neither loader is parallel
+ * capable).
+ */
+public abstract class DiscClassDefiner implements DiscClassPatcher.Resolver {
+
+    protected DiscClassDefiner(DiscClassPatcher patcher, String loaderName) {
+        this.patcher = patcher;
+        this.loaderName = loaderName;
+    }
+
+    /* the loader's own resource (its URLs only, no parent) */
+    protected abstract URL findOwnResource(String path);
+    /* the loader's classpath URLs */
+    protected abstract URL[] getClassPath();
+    protected abstract Package getPkg(String name);
+    protected abstract Package definePkg(String name, Manifest man, URL url);
+    protected abstract Package definePkg(String name, String specTitle, String specVersion, String specVendor,
+                                         String implTitle, String implVersion, String implVendor, URL sealBase);
+    /* the 5-argument SecureClassLoader.defineClass */
+    protected abstract Class define(String name, byte[] b, CodeSource cs);
+
+    /* a class outside this loader's jars that may still be a disc class
+     * (DVBClassLoader with a disc parent): its bytes' URL, never loaded */
+    protected URL findOuterDiscResource(String path) {
+        return null;
+    }
+
+    /* the loader's classpath changed: drop the class info cache */
+    public synchronized void classPathChanged() {
+        infoCache.clear();
+        outerCache.clear();
+    }
+
+    /*
+     * findClass
+     */
+
+    public Class findClass(String name) throws ClassNotFoundException {
+        String path = name.replace('.', '/').concat(".class");
+        URL res = findOwnResource(path);
+        if (res == null)
+            throw new ClassNotFoundException(name);
+
+        Loaded l;
+        try {
+            l = load(res);
+        } catch (IOException e) {
+            logger.error("loading " + name + " failed: " + e);
+            throw new ClassNotFoundException(name);
+        }
+        noteJar(l);
+
+        DiscClassPatcher.Result r = patch(name, l.bytes);
+        Class c;
+        try {
+            definePackageFor(name, l);
+            c = define(name, r.bytes, l.cs);
+        } catch (ClassFormatError ce) {
+            /* broken debug info (Penguins of Madagascar): strip, patch again */
+            logger.error("defining " + name + " failed: " + ce + ", retrying with debug info stripped");
+            byte[] s;
+            try {
+                s = new BDJClassFileTransformer().strip(l.bytes, 0, l.bytes.length);
+                r = patch(name, s);
+                c = define(name, r.bytes, l.cs);
+            } catch (ThreadDeath td) {
+                throw td;
+            } catch (ClassNotFoundException cnfe) {
+                throw cnfe;
+            } catch (Throwable t) {
+                logger.error("Class rewriting failed: " + t);
+                throw new ClassNotFoundException(name);
+            }
+            count(D_STRIPPED, 1);
+        }
+
+        count(D_CLASSES, 1);
+        if (r.kind == DiscClassPatcher.R_PATCHED)
+            count(D_PATCHED, 1);
+        if (r.timerRemapped)
+            count(D_TIMER_REMAPPED, 1);
+        if (l.cs.getCodeSigners() != null)
+            count(D_SIGNED, 1);
+        maybeReport();
+        return c;
+    }
+
+    private DiscClassPatcher.Result patch(String name, byte[] b) throws ClassNotFoundException {
+        DiscClassPatcher.Result r = patcher.patch(name, b, this);
+        synchronized (this) {
+            for (int i = 0; i < DiscClassPatcher.K_COUNT; i++)
+                kinds[i] += r.counts[i];
+        }
+        if (r.kind == DiscClassPatcher.R_FAILED) {
+            logger.error("DISCDIAG TEMP disc time: class " + name + " names java.util.Timer/TimerTask and cannot be" +
+                         " remapped, not defined: " + r.error);
+            fail(name, "timer_unparseable");
+            throw new ClassNotFoundException(name);
+        }
+        if (r.kind == DiscClassPatcher.R_UNPARSEABLE) {
+            logger.error("DISCDIAG TEMP disc time: class " + name + " cannot be patched, defined unpatched: " + r.error);
+            fail(name, "unpatched");
+        }
+        if (r.debugDropped) {
+            logger.error("class " + name + " patched with its debug info dropped (unparseable)");
+            count(D_DEBUG_DROPPED, 1);
+        }
+        return r;
+    }
+
+    /*
+     * one define path
+     */
+
+    private static final class Loaded {
+        byte[] bytes;
+        CodeSource cs;
+        Manifest man;   /* null for a directory */
+        URL url;        /* jar file / directory URL */
+    }
+
+    private Loaded load(final URL res) throws IOException {
+        try {
+            return (Loaded)AccessController.doPrivileged(new PrivilegedExceptionAction() {
+                    public Object run() throws IOException {
+                        return loadPrivileged(res);
+                    }
+                });
+        } catch (PrivilegedActionException e) {
+            throw (IOException)e.getException();
+        }
+    }
+
+    private Loaded loadPrivileged(URL res) throws IOException {
+        Loaded l = new Loaded();
+        CodeSigner[] signers = null;
+        URLConnection uc = res.openConnection();  /* does not connect */
+        if (uc instanceof JarURLConnection) {
+            /* our own JarFile, as URLClassLoader's: the JarURLConnection
+             * cache would keep it open past the loader and serve a stale
+             * jar to a later disc with the same jar path */
+            JarURLConnection juc = (JarURLConnection)uc;
+            l.url = juc.getJarFileURL();
+            JarFile jf = jarFile(l.url);
+            JarEntry je = jf.getJarEntry(juc.getEntryName());
+            if (je == null)
+                throw new IOException("no entry " + juc.getEntryName() + " in " + l.url);
+            /* signers exist only once the entry was read to EOF */
+            l.bytes = readAll(jf.getInputStream(je));
+            signers = je.getCodeSigners();
+            l.man = jf.getManifest();
+        } else {
+            l.bytes = readAll(uc.getInputStream());
+            l.url = classPathEntryFor(res);
+        }
+        l.cs = new CodeSource(l.url, signers);
+        return l;
+    }
+
+    private byte[] readBytesPrivileged(URL res) throws IOException {
+        URLConnection uc = res.openConnection();
+        if (uc instanceof JarURLConnection) {
+            JarURLConnection juc = (JarURLConnection)uc;
+            JarFile jf = jarFile(juc.getJarFileURL());
+            JarEntry je = jf.getJarEntry(juc.getEntryName());
+            if (je == null)
+                return null;
+            return readAll(jf.getInputStream(je));
+        }
+        return readAll(uc.getInputStream());
+    }
+
+    private final HashMap jarFiles = new HashMap(); /* jar file URL string -> JarFile */
+
+    private synchronized JarFile jarFile(URL jarFileURL) throws IOException {
+        String key = jarFileURL.toExternalForm();
+        JarFile jf = (JarFile)jarFiles.get(key);
+        if (jf == null) {
+            if (closed)
+                throw new IOException("loader closed");
+            if (!"file".equals(jarFileURL.getProtocol()))
+                throw new IOException("not a local jar: " + key);
+            String path = jarFileURL.getFile().replace('/', File.separatorChar);
+            path = decodePercent(path);
+            jf = new JarFile(new File(path), true);
+            jarFiles.put(key, jf);
+        }
+        return jf;
+    }
+
+    /* %xx only, as URLClassLoader's ParseUtil.decode ('+' stays) */
+    private static String decodePercent(String s) throws IOException {
+        if (s.indexOf('%') < 0)
+            return s;
+        ByteArrayOutputStream os = new ByteArrayOutputStream();
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '%' && i + 2 < s.length()) {
+                try {
+                    os.write(Integer.parseInt(s.substring(i + 1, i + 3), 16));
+                } catch (NumberFormatException e) {
+                    throw new IOException("bad URL path " + s);
+                }
+                i += 2;
+            } else {
+                byte[] b = String.valueOf(c).getBytes("UTF-8");
+                os.write(b, 0, b.length);
+            }
+        }
+        return new String(os.toByteArray(), "UTF-8");
+    }
+
+    private boolean closed = false;
+
+    /* the loader is closed: close the jars */
+    public void close() {
+        synchronized (this) {
+            closed = true;
+            Iterator it = jarFiles.values().iterator();
+            while (it.hasNext()) {
+                try {
+                    ((JarFile)it.next()).close();
+                } catch (IOException e) {
+                }
+            }
+            jarFiles.clear();
+        }
+    }
+
+    /* the classpath directory URL a file: resource came from */
+    private URL classPathEntryFor(URL res) {
+        String s = res.toExternalForm();
+        URL[] cp = getClassPath();
+        URL best = null;
+        for (int i = 0; i < cp.length; i++) {
+            String p = cp[i].toExternalForm();
+            if (s.startsWith(p) && (best == null || p.length() > best.toExternalForm().length()))
+                best = cp[i];
+        }
+        return best != null ? best : res;
+    }
+
+    private static byte[] readAll(InputStream is) throws IOException {
+        try {
+            ByteArrayOutputStream os = new ByteArrayOutputStream();
+            byte[] buffer = new byte[0x4000];
+            int r;
+            while ((r = is.read(buffer)) != -1)
+                os.write(buffer, 0, r);
+            return os.toByteArray();
+        } finally {
+            try {
+                is.close();
+            } catch (IOException e) {
+            }
+        }
+    }
+
+    /* URLClassLoader.defineClass / definePackage / isSealed (JDK 8) */
+    private void definePackageFor(String name, Loaded l) {
+        int i = name.lastIndexOf('.');
+        if (i == -1)
+            return;
+        String pkgname = name.substring(0, i);
+        Package pkg = getPkg(pkgname);
+        if (pkg != null) {
+            if (pkg.isSealed()) {
+                if (!pkg.isSealed(l.url))
+                    throw new SecurityException("sealing violation: package " + pkgname + " is sealed");
+            } else {
+                if ((l.man != null) && isSealed(pkgname, l.man))
+                    throw new SecurityException("sealing violation: can't seal package " + pkgname + ": already loaded");
+            }
+        } else {
+            try {
+                if (l.man != null)
+                    definePkg(pkgname, l.man, l.url);
+                else
+                    definePkg(pkgname, null, null, null, null, null, null, null);
+            } catch (IllegalArgumentException iae) {
+                if (getPkg(pkgname) == null)
+                    throw new AssertionError("Cannot find package " + pkgname);
+            }
+        }
+    }
+
+    private static boolean isSealed(String name, Manifest man) {
+        String path = name.replace('.', '/').concat("/");
+        Attributes attr = man.getAttributes(path);
+        String sealed = null;
+        if (attr != null)
+            sealed = attr.getValue(Attributes.Name.SEALED);
+        if (sealed == null) {
+            if ((attr = man.getMainAttributes()) != null)
+                sealed = attr.getValue(Attributes.Name.SEALED);
+        }
+        return "true".equalsIgnoreCase(sealed);
+    }
+
+    /*
+     * DiscClassPatcher.Resolver: superclass chains from the jar's bytes
+     */
+
+    private final HashMap infoCache = new HashMap();   /* internal name -> ClassInfo or NONE */
+    private final HashMap outerCache = new HashMap();  /* internal name -> Class or NONE */
+    private static final Object NONE = new Object();
+
+    public synchronized DiscClassPatcher.ClassInfo jarClass(String internalName) {
+        Object o = infoCache.get(internalName);
+        if (o == null) {
+            o = NONE;
+            String path = internalName + ".class";
+            URL u = findOwnResource(path);
+            if (u == null && outerClass(internalName) == null) {
+                /* not JDK / libbluray: a disc class of a parent loader
+                 * (DVBClassLoader), walked on from its bytes */
+                u = findOuterDiscResource(path);
+            }
+            if (u != null) {
+                DiscClassPatcher.ClassInfo info = readInfo(u);
+                if (info != null)
+                    o = info;
+            }
+            infoCache.put(internalName, o);
+        }
+        return o == NONE ? null : (DiscClassPatcher.ClassInfo)o;
+    }
+
+    public synchronized Class outerClass(String internalName) {
+        Object o = outerCache.get(internalName);
+        if (o == null) {
+            o = resolveOuter(internalName.replace('/', '.'));
+            if (o == null)
+                o = NONE;
+            outerCache.put(internalName, o);
+        }
+        return o == NONE ? null : (Class)o;
+    }
+
+    /* JDK and libbluray classes only: the system class loader never sees
+     * a disc class */
+    private static Class resolveOuter(final String name) {
+        return (Class)AccessController.doPrivileged(new PrivilegedAction() {
+                public Object run() {
+                    try {
+                        return Class.forName(name, false, ClassLoader.getSystemClassLoader());
+                    } catch (ClassNotFoundException e) {
+                        return null;
+                    } catch (LinkageError e) {
+                        return null;
+                    }
+                }
+            });
+    }
+
+    private DiscClassPatcher.ClassInfo readInfo(final URL u) {
+        byte[] b = (byte[])AccessController.doPrivileged(new PrivilegedAction() {
+                public Object run() {
+                    try {
+                        return readBytesPrivileged(u);
+                    } catch (IOException e) {
+                        return null;
+                    }
+                }
+            });
+        return b == null ? null : DiscClassPatcher.readClassInfo(b);
+    }
+
+    /*
+     * DISCDIAG TEMP: per loader counts, a line per jar at its first class,
+     * a summary at most once per 10 s, after the xlet class load and at
+     * xlet shutdown; every failure is logged with its class name.
+     */
+
+    private static final int D_CLASSES        = 0;
+    private static final int D_PATCHED        = 1;
+    private static final int D_TIMER_REMAPPED = 2;
+    private static final int D_STRIPPED       = 3;
+    private static final int D_DEBUG_DROPPED  = 4;
+    private static final int D_SIGNED         = 5;
+    private static final int D_COUNT          = 6;
+    private static final String[] D_NAMES = {
+        "classes", "patched", "timer_remapped", "stripped", "debug_dropped", "signed",
+    };
+
+    private final long[] counts = new long[D_COUNT];
+    private final long[] kinds = new long[DiscClassPatcher.K_COUNT];
+    private final StringBuffer failures = new StringBuffer();
+    private int failureCount = 0;
+    private final HashSet jarsSeen = new HashSet();
+    private boolean dirty = false;
+    private long lastReportNs = System.nanoTime();
+    private static final long REPORT_PERIOD_NS = 10000000000L;
+
+    private synchronized void count(int kind, int n) {
+        counts[kind] += n;
+        dirty = true;
+    }
+
+    private synchronized void fail(String name, String why) {
+        failureCount++;
+        if (failures.length() < 2000)
+            failures.append(' ').append(name).append('(').append(why).append(')');
+        dirty = true;
+    }
+
+    private void noteJar(Loaded l) {
+        String key = l.url.toExternalForm();
+        synchronized (this) {
+            if (!jarsSeen.add(key))
+                return;
+        }
+        logger.info("DISCDIAG TEMP disc time: " + loaderName + " loads from " + key +
+                    " signed=" + (l.cs.getCodeSigners() != null) +
+                    " manifest=" + (l.man != null) +
+                    " sealed=" + (l.man != null && "true".equalsIgnoreCase(
+                                      l.man.getMainAttributes().getValue(Attributes.Name.SEALED))));
+    }
+
+    private void maybeReport() {
+        report(null, false);
+    }
+
+    public void report(String why) {
+        report(why, true);
+    }
+
+    private void report(String why, boolean force) {
+        String msg;
+        synchronized (this) {
+            long now = System.nanoTime();
+            if (!dirty)
+                return;
+            if (!force && now - lastReportNs < REPORT_PERIOD_NS)
+                return;
+            lastReportNs = now;
+            dirty = false;
+            StringBuffer sb = new StringBuffer("DISCDIAG TEMP disc time patcher ");
+            sb.append(loaderName);
+            if (why != null)
+                sb.append(" (").append(why).append(")");
+            sb.append(':');
+            for (int i = 0; i < D_COUNT; i++)
+                sb.append(' ').append(D_NAMES[i]).append('=').append(counts[i]);
+            for (int i = 0; i < DiscClassPatcher.K_COUNT; i++)
+                sb.append(' ').append(DiscClassPatcher.K_NAMES[i]).append('=').append(kinds[i]);
+            sb.append(" failures=").append(failureCount);
+            if (failureCount > 0)
+                sb.append(" [").append(failures.toString().trim()).append(']');
+            msg = sb.toString();
+        }
+        logger.info(msg);
+    }
+
+    private final DiscClassPatcher patcher;
+    private final String loaderName;
+
+    private static final Logger logger = Logger.getLogger(DiscClassDefiner.class.getName());
+}
