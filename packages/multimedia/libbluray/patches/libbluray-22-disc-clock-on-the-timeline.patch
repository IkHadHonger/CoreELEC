+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+package org.videolan;
+
+import java.util.Date;
+
+/*
+ * java.util.Timer (OpenJDK 8 semantics) scheduled on disc time: delays and
+ * Date instants are disc milliseconds (DiscTime.currentTimeMillis), so a
+ * task does not run while disc time is frozen. Disc classes that use
+ * java.util.Timer are remapped onto this class, so it is not final.
+ *
+ * The timer thread is created in the caller's thread group (an xlet's
+ * timer belongs to that xlet: getCurrentContext() works in its tasks and
+ * xlet shutdown stops it).
+ *
+ * The queue loop waits on its own queue (not via DiscTime.waitOn), with a
+ * wall timeout equal to the disc time left; a wait that ends with disc time
+ * short re-checks, in slices of at most 50 ms only while frozen.
+ *
+ * Off (DiscTime.isOff() at construction): the clock is
+ * System.currentTimeMillis, as java.util.Timer.
+ */
+public class DiscTimer {
+
+    private final TaskQueue queue = new TaskQueue();
+
+    private final TimerThread thread;
+
+    private final boolean wallClock;
+
+    /* stops the thread when the timer is garbage and its queue is empty */
+    private final Object threadReaper = new Object() {
+        protected void finalize() throws Throwable {
+            synchronized (queue) {
+                thread.newTasksMayBeScheduled = false;
+                queue.notify();
+            }
+        }
+    };
+
+    private static int nextSerialNumber = 0;
+
+    private static synchronized int serialNumber() {
+        return nextSerialNumber++;
+    }
+
+    public DiscTimer() {
+        this("Timer-" + serialNumber());
+    }
+
+    public DiscTimer(boolean isDaemon) {
+        this("Timer-" + serialNumber(), isDaemon);
+    }
+
+    /* as java.util.Timer(String): the thread keeps the daemon status it
+     * inherits from its creator */
+    public DiscTimer(String name) {
+        this(name, null);
+    }
+
+    public DiscTimer(String name, boolean isDaemon) {
+        this(name, isDaemon ? Boolean.TRUE : Boolean.FALSE);
+    }
+
+    private DiscTimer(String name, Boolean isDaemon) {
+        if (name == null) {
+            /* as Thread.setName(null) in java.util.Timer */
+            throw new NullPointerException("name cannot be null");
+        }
+        wallClock = DiscTime.isOff();
+        thread = new TimerThread(Thread.currentThread().getThreadGroup(), name, queue, wallClock);
+        if (isDaemon != null)
+            thread.setDaemon(isDaemon.booleanValue());
+        thread.start();
+    }
+
+    /* the timer's clock (ms) */
+    long now() {
+        return wallClock ? System.currentTimeMillis() : DiscTime.currentTimeMillis();
+    }
+
+    public void schedule(DiscTimerTask task, long delay) {
+        if (delay < 0)
+            throw new IllegalArgumentException("Negative delay.");
+        sched(task, now() + delay, 0);
+    }
+
+    public void schedule(DiscTimerTask task, Date time) {
+        sched(task, time.getTime(), 0);
+    }
+
+    public void schedule(DiscTimerTask task, long delay, long period) {
+        if (delay < 0)
+            throw new IllegalArgumentException("Negative delay.");
+        if (period <= 0)
+            throw new IllegalArgumentException("Non-positive period.");
+        sched(task, now() + delay, -period);
+    }
+
+    public void schedule(DiscTimerTask task, Date firstTime, long period) {
+        if (period <= 0)
+            throw new IllegalArgumentException("Non-positive period.");
+        sched(task, firstTime.getTime(), -period);
+    }
+
+    public void scheduleAtFixedRate(DiscTimerTask task, long delay, long period) {
+        if (delay < 0)
+            throw new IllegalArgumentException("Negative delay.");
+        if (period <= 0)
+            throw new IllegalArgumentException("Non-positive period.");
+        sched(task, now() + delay, period);
+    }
+
+    public void scheduleAtFixedRate(DiscTimerTask task, Date firstTime, long period) {
+        if (period <= 0)
+            throw new IllegalArgumentException("Non-positive period.");
+        sched(task, firstTime.getTime(), period);
+    }
+
+    private void sched(DiscTimerTask task, long time, long period) {
+        if (time < 0)
+            throw new IllegalArgumentException("Illegal execution time.");
+
+        /* constrain the period to prevent numeric overflow */
+        if (Math.abs(period) > (Long.MAX_VALUE >> 1))
+            period >>= 1;
+
+        synchronized (queue) {
+            if (!thread.newTasksMayBeScheduled)
+                throw new IllegalStateException("Timer already cancelled.");
+
+            synchronized (task.lock) {
+                if (task.state != DiscTimerTask.VIRGIN)
+                    throw new IllegalStateException(
+                        "Task already scheduled or cancelled");
+                task.nextExecutionTime = time;
+                task.period = period;
+                task.state = DiscTimerTask.SCHEDULED;
+            }
+
+            queue.add(task);
+            if (queue.getMin() == task)
+                queue.notify();
+        }
+    }
+
+    public void cancel() {
+        synchronized (queue) {
+            thread.newTasksMayBeScheduled = false;
+            queue.clear();
+            queue.notify();
+        }
+    }
+
+    public int purge() {
+        int result = 0;
+
+        synchronized (queue) {
+            for (int i = queue.size(); i > 0; i--) {
+                if (queue.get(i).state == DiscTimerTask.CANCELLED) {
+                    queue.quickRemove(i);
+                    result++;
+                }
+            }
+
+            if (result != 0)
+                queue.heapify();
+        }
+
+        return result;
+    }
+
+    /*
+     * java.util.TimerThread on disc time
+     */
+
+    private static final class TimerThread extends Thread {
+
+        boolean newTasksMayBeScheduled = true;
+
+        private final TaskQueue queue;
+        private final boolean wallClock;
+
+        TimerThread(ThreadGroup group, String name, TaskQueue queue, boolean wallClock) {
+            super(group, name);
+            this.queue = queue;
+            this.wallClock = wallClock;
+        }
+
+        public void run() {
+            try {
+                mainLoop();
+            } finally {
+                synchronized (queue) {
+                    newTasksMayBeScheduled = false;
+                    queue.clear();
+                }
+            }
+        }
+
+        private long now() {
+            return wallClock ? System.currentTimeMillis() : DiscTime.currentTimeMillis();
+        }
+
+        private void mainLoop() {
+            /* disc time was frozen over the last timed wait */
+            boolean frozen = false;
+
+            while (true) {
+                try {
+                    DiscTimerTask task;
+                    boolean taskFired;
+                    synchronized (queue) {
+                        while (queue.isEmpty() && newTasksMayBeScheduled)
+                            queue.wait();
+                        if (queue.isEmpty())
+                            break;
+
+                        long currentTime, executionTime;
+                        task = queue.getMin();
+                        synchronized (task.lock) {
+                            if (task.state == DiscTimerTask.CANCELLED) {
+                                queue.removeMin();
+                                continue;
+                            }
+                            currentTime = now();
+                            executionTime = task.nextExecutionTime;
+                            if (taskFired = (executionTime <= currentTime)) {
+                                if (task.period == 0) {
+                                    queue.removeMin();
+                                    task.state = DiscTimerTask.EXECUTED;
+                                } else {
+                                    queue.rescheduleMin(
+                                        task.period < 0 ? currentTime   - task.period
+                                                        : executionTime + task.period);
+                                }
+                            }
+                        }
+                        if (!taskFired) {
+                            long waitMs = executionTime - currentTime;
+                            if (wallClock) {
+                                queue.wait(waitMs);
+                            } else {
+                                if (frozen && waitMs > 50)
+                                    waitMs = 50;
+                                long wall0 = System.nanoTime();
+                                long disc0 = Libbluray.discTimeNanos();
+                                queue.wait(waitMs);
+                                long disc1 = Libbluray.discTimeNanos();
+                                long wall1 = System.nanoTime();
+                                frozen = DiscTime.frozenDuring(wall0, wall1, disc0, disc1);
+                                if (frozen)
+                                    DiscTime.diagCount(DiscTime.D_TIMER_FROZEN_RECHECKS);
+                            }
+                        }
+                    }
+                    if (taskFired) {
+                        if (!wallClock) {
+                            DiscTime.diagCount(DiscTime.D_TIMER_FIRINGS);
+                            DiscTime.diagMaybeReport();
+                        }
+                        task.run();
+                    }
+                } catch (InterruptedException e) {
+                }
+            }
+        }
+    }
+
+    /*
+     * java.util.TaskQueue: a priority queue of tasks ordered on
+     * nextExecutionTime (balanced binary heap, queue[1] is the min)
+     */
+
+    private static final class TaskQueue {
+
+        private DiscTimerTask[] queue = new DiscTimerTask[128];
+
+        private int size = 0;
+
+        int size() {
+            return size;
+        }
+
+        void add(DiscTimerTask task) {
+            if (size + 1 == queue.length) {
+                DiscTimerTask[] grown = new DiscTimerTask[2 * queue.length];
+                System.arraycopy(queue, 0, grown, 0, queue.length);
+                queue = grown;
+            }
+
+            queue[++size] = task;
+            fixUp(size);
+        }
+
+        DiscTimerTask getMin() {
+            return queue[1];
+        }
+
+        DiscTimerTask get(int i) {
+            return queue[i];
+        }
+
+        void removeMin() {
+            queue[1] = queue[size];
+            queue[size--] = null;
+            fixDown(1);
+        }
+
+        void quickRemove(int i) {
+            /* assert i <= size; */
+            queue[i] = queue[size];
+            queue[size--] = null;
+        }
+
+        void rescheduleMin(long newTime) {
+            queue[1].nextExecutionTime = newTime;
+            fixDown(1);
+        }
+
+        boolean isEmpty() {
+            return size == 0;
+        }
+
+        void clear() {
+            for (int i = 1; i <= size; i++)
+                queue[i] = null;
+
+            size = 0;
+        }
+
+        private void fixUp(int k) {
+            while (k > 1) {
+                int j = k >> 1;
+                if (queue[j].nextExecutionTime <= queue[k].nextExecutionTime)
+                    break;
+                DiscTimerTask tmp = queue[j];  queue[j] = queue[k]; queue[k] = tmp;
+                k = j;
+            }
+        }
+
+        private void fixDown(int k) {
+            int j;
+            while ((j = k << 1) <= size && j > 0) {
+                if (j < size &&
+                    queue[j].nextExecutionTime > queue[j + 1].nextExecutionTime)
+                    j++;
+                if (queue[k].nextExecutionTime <= queue[j].nextExecutionTime)
+                    break;
+                DiscTimerTask tmp = queue[j];  queue[j] = queue[k]; queue[k] = tmp;
+                k = j;
+            }
+        }
+
+        void heapify() {
+            for (int i = size / 2; i >= 1; i--)
+                fixDown(i);
+        }
+    }
+}
