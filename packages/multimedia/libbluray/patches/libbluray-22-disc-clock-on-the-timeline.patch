+package org.videolan;
+
+/*
+ * java.util.TimerTask (OpenJDK 8 semantics) for DiscTimer: times are disc
+ * milliseconds (DiscTime.currentTimeMillis). Disc classes that extend
+ * java.util.TimerTask are remapped onto this class.
+ */
+public abstract class DiscTimerTask implements Runnable {
+
+    final Object lock = new Object();
+
+    int state = VIRGIN;
+
+    static final int VIRGIN = 0;
+    static final int SCHEDULED = 1;
+    static final int EXECUTED = 2;
+    static final int CANCELLED = 3;
+
+    /* disc ms; for a repeating task updated before each execution */
+    long nextExecutionTime;
+
+    /* > 0 fixed rate, < 0 fixed delay, 0 one-shot */
+    long period = 0;
+
+    protected DiscTimerTask() {
+    }
+
+    public abstract void run();
+
+    public boolean cancel() {
+        synchronized (lock) {
+            boolean result = (state == SCHEDULED);
+            state = CANCELLED;
+            return result;
+        }
+    }
+
+    public long scheduledExecutionTime() {
+        synchronized (lock) {
+            return (period < 0 ? nextExecutionTime + period
+                               : nextExecutionTime - period);
+        }
+    }
+}
