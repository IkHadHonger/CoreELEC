+package org.videolan;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.commons.RemappingClassAdapter;
+import org.objectweb.asm.commons.SimpleRemapper;
+
+/*
+ * Disc time (phase 5): the bytecode patcher for disc classes.
+ *
+ * Rewrites (ASM, ClassReader EXPAND_FRAMES, ClassWriter flags 0, debug
+ * info kept):
+ *  - invokestatic java/lang/System.currentTimeMillis()J / nanoTime()J
+ *    -> DiscTime;
+ *  - invokestatic sleep(J)V / (JI)V whose target resolves to
+ *    java/lang/Thread.sleep -> DiscTime.sleep;
+ *  - invokevirtual/special/interface wait(J)V / (JI)V whose target resolves
+ *    to java/lang/Object.wait -> DiscTime.waitOn (static; the receiver
+ *    becomes the first argument: same operand stack shape);
+ *  - invokevirtual/special/interface join(J)V / (JI)V whose target
+ *    resolves to java/lang/Thread.join -> DiscTime.joinOn;
+ *  - only for classes whose constant pool names java/util/Timer*:
+ *    RemappingClassAdapter java/util/Timer -> org/videolan/DiscTimer,
+ *    java/util/TimerTask -> org/videolan/DiscTimerTask (the remapper
+ *    renumbers locals, so it never runs on other classes).
+ *
+ * A target "resolves" to the JDK method when no disc class on the owner's
+ * superclass chain declares the same name and descriptor and the chain
+ * reaches java/lang/Thread (sleep, join) / any class (wait). The chain is
+ * read from the class bytes of the loader's own resources, never by
+ * loading; the first class outside them is resolved by the Resolver
+ * (JDK / libbluray classes only). Anything unresolved is left unchanged.
+ *
+ * The patcher holds no state: one instance per xlet context, the per
+ * loader state (class info cache, DISCDIAG counts) is in the Resolver /
+ * Stats the caller passes.
+ */
+public final class DiscClassPatcher {
+
+    /* null when disc time is off: no patcher, today's class loading */
+    public static DiscClassPatcher create() {
+        if (Libbluray.discTimeOff())
+            return null;
+        return new DiscClassPatcher();
+    }
+
+    DiscClassPatcher() {
+    }
+
+    /*
+     * what the patcher needs from the loader
+     */
+    public interface Resolver {
+        /* declared methods / super of a class in the loader's own jars,
+         * or null when the class is not there */
+        ClassInfo jarClass(String internalName);
+        /* a class outside the jars (JDK / libbluray), never a disc class;
+         * null when it cannot be resolved */
+        Class outerClass(String internalName);
+    }
+
+    public static final class ClassInfo {
+        final String superName;
+        final HashSet methods = new HashSet(); /* name + desc */
+
+        ClassInfo(String superName) {
+            this.superName = superName;
+        }
+
+        boolean declares(String name, String desc) {
+            return methods.contains(name + desc);
+        }
+    }
+
+    /* superclass and declared methods from class bytes; null if unparseable */
+    public static ClassInfo readClassInfo(byte[] b) {
+        try {
+            ClassReader cr = new ClassReader(b);
+            final ClassInfo[] info = new ClassInfo[1];
+            cr.accept(new ClassVisitor(Opcodes.ASM5) {
+                    public void visit(int version, int access, String name, String signature,
+                                      String superName, String[] interfaces) {
+                        info[0] = new ClassInfo(superName);
+                    }
+                    public MethodVisitor visitMethod(int access, String name, String desc,
+                                                     String signature, String[] exceptions) {
+                        info[0].methods.add(name + desc);
+                        return null;
+                    }
+                }, ClassReader.SKIP_CODE | ClassReader.SKIP_DEBUG | ClassReader.SKIP_FRAMES);
+            return info[0];
+        } catch (ThreadDeath td) {
+            throw td;
+        } catch (VirtualMachineError e) {
+            throw e;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /*
+     * DISCDIAG TEMP: counts by rewrite kind, per loader
+     */
+    public static final int K_MILLIS          = 0;
+    public static final int K_NANOS           = 1;
+    public static final int K_SLEEP           = 2;
+    public static final int K_WAIT            = 3;
+    public static final int K_JOIN            = 4;
+    public static final int K_KEPT_OVERRIDE   = 5;  /* a disc class declares the name+desc */
+    public static final int K_KEPT_UNRESOLVED = 6;  /* chain not resolvable */
+    public static final int K_REFLECT_TIMER   = 7;  /* "java.util.Timer*" string in the pool (ClassCastException risk) */
+    public static final int K_COUNT           = 8;
+
+    public static final String[] K_NAMES = {
+        "millis", "nanos", "sleep", "wait", "join",
+        "kept_override", "kept_unresolved", "reflect_timer_name",
+    };
+
+    /*
+     * result
+     */
+    public static final int R_UNCHANGED   = 0;  /* bytes are the input */
+    public static final int R_PATCHED     = 1;
+    public static final int R_UNPARSEABLE = 2;  /* bytes are the input; ERROR logged by the caller */
+    public static final int R_FAILED      = 3;  /* names the Timer types and cannot be remapped */
+
+    public static final class Result {
+        public final int kind;
+        public final byte[] bytes;
+        public final boolean timerRemapped;
+        public final boolean debugDropped;
+        public final int[] counts;
+        public final Throwable error;
+
+        Result(int kind, byte[] bytes, boolean timerRemapped, boolean debugDropped, int[] counts, Throwable error) {
+            this.kind = kind;
+            this.bytes = bytes;
+            this.timerRemapped = timerRemapped;
+            this.debugDropped = debugDropped;
+            this.counts = counts;
+            this.error = error;
+        }
+    }
+
+    public Result patch(String className, byte[] b, Resolver resolver) {
+        PoolScan scan = PoolScan.scan(b);
+        boolean namesTimer;
+        if (scan != null) {
+            namesTimer = scan.namesTimer;
+        } else {
+            namesTimer = rawContains(b, "java/util/Timer");
+        }
+
+        int[] counts = new int[K_COUNT];
+        if (scan != null && scan.reflectTimer)
+            counts[K_REFLECT_TIMER]++;
+
+        if (scan != null && !scan.timeNames && !namesTimer)
+            return new Result(R_UNCHANGED, b, false, false, counts, null);
+
+        byte[] out;
+        boolean debugDropped = false;
+        int[] c = new int[K_COUNT];
+        try {
+            out = rewrite(b, namesTimer, true, resolver, c);
+        } catch (ThreadDeath td) {
+            throw td;
+        } catch (VirtualMachineError e) {
+            throw e;
+        } catch (Throwable t1) {
+            /* broken debug info (see BDJClassFileTransformer.strip) */
+            c = new int[K_COUNT];
+            try {
+                out = rewrite(b, namesTimer, false, resolver, c);
+                debugDropped = true;
+            } catch (ThreadDeath td) {
+                throw td;
+            } catch (VirtualMachineError e) {
+                throw e;
+            } catch (Throwable t2) {
+                return new Result(namesTimer ? R_FAILED : R_UNPARSEABLE, b, false, false, counts, t2);
+            }
+        }
+
+        for (int i = 0; i < K_COUNT; i++)
+            counts[i] += c[i];
+
+        int rewrites = c[K_MILLIS] + c[K_NANOS] + c[K_SLEEP] + c[K_WAIT] + c[K_JOIN];
+        if (rewrites == 0 && !namesTimer)
+            return new Result(R_UNCHANGED, b, false, false, counts, null);
+
+        return new Result(R_PATCHED, out, namesTimer, debugDropped, counts, null);
+    }
+
+    private static final String DISC_TIME = "org/videolan/DiscTime";
+
+    private static final Map TIMER_MAP = new HashMap();
+    static {
+        TIMER_MAP.put("java/util/Timer", "org/videolan/DiscTimer");
+        TIMER_MAP.put("java/util/TimerTask", "org/videolan/DiscTimerTask");
+    }
+
+    private byte[] rewrite(byte[] b, boolean remapTimer, boolean keepDebug, Resolver resolver, int[] counts) {
+        ClassReader cr = new ClassReader(b);
+        ClassWriter cw = new ClassWriter(cr, 0);
+        ClassVisitor cv = cw;
+        if (remapTimer)
+            cv = new RemappingClassAdapter(cv, new SimpleRemapper(TIMER_MAP));
+        /* the call rewriter sees the original names, the remapper after it */
+        cv = new CallClassVisitor(cv, resolver, counts);
+        cr.accept(cv, ClassReader.EXPAND_FRAMES | (keepDebug ? 0 : ClassReader.SKIP_DEBUG));
+        return cw.toByteArray();
+    }
+
+    private static final class CallClassVisitor extends ClassVisitor {
+        private final Resolver resolver;
+        private final int[] counts;
+        private final HashMap cache = new HashMap(); /* owner+name+desc -> Integer */
+
+        CallClassVisitor(ClassVisitor cv, Resolver resolver, int[] counts) {
+            super(Opcodes.ASM5, cv);
+            this.resolver = resolver;
+            this.counts = counts;
+        }
+
+        public MethodVisitor visitMethod(int access, String name, String desc,
+                                         String signature, String[] exceptions) {
+            MethodVisitor mv = super.visitMethod(access, name, desc, signature, exceptions);
+            if (mv == null)
+                return null;
+            return new CallMethodVisitor(mv, this);
+        }
+
+        int resolve(String owner, String name, String desc, boolean needThread) {
+            String key = owner + "." + name + desc;
+            Integer r = (Integer)cache.get(key);
+            if (r == null) {
+                r = new Integer(resolveTarget(resolver, owner, name, desc, needThread));
+                cache.put(key, r);
+            }
+            return r.intValue();
+        }
+    }
+
+    private static final class CallMethodVisitor extends MethodVisitor {
+        private final CallClassVisitor cls;
+
+        CallMethodVisitor(MethodVisitor mv, CallClassVisitor cls) {
+            super(Opcodes.ASM5, mv);
+            this.cls = cls;
+        }
+
+        public void visitMethodInsn(int opcode, String owner, String name, String desc, boolean itf) {
+            int[] counts = cls.counts;
+
+            if (opcode == Opcodes.INVOKESTATIC) {
+                if (owner.equals("java/lang/System") && desc.equals("()J")) {
+                    if (name.equals("currentTimeMillis")) {
+                        counts[K_MILLIS]++;
+                        super.visitMethodInsn(Opcodes.INVOKESTATIC, DISC_TIME, "currentTimeMillis", "()J", false);
+                        return;
+                    }
+                    if (name.equals("nanoTime")) {
+                        counts[K_NANOS]++;
+                        super.visitMethodInsn(Opcodes.INVOKESTATIC, DISC_TIME, "nanoTime", "()J", false);
+                        return;
+                    }
+                }
+                if (name.equals("sleep") && (desc.equals("(J)V") || desc.equals("(JI)V"))) {
+                    int r = cls.resolve(owner, name, desc, true);
+                    if (r == T_JDK) {
+                        counts[K_SLEEP]++;
+                        super.visitMethodInsn(Opcodes.INVOKESTATIC, DISC_TIME, "sleep", desc, false);
+                        return;
+                    }
+                    count(counts, r);
+                }
+            } else if (opcode == Opcodes.INVOKEVIRTUAL || opcode == Opcodes.INVOKESPECIAL ||
+                       opcode == Opcodes.INVOKEINTERFACE) {
+                boolean j1 = desc.equals("(J)V");
+                if (j1 || desc.equals("(JI)V")) {
+                    if (name.equals("wait")) {
+                        int r = cls.resolve(owner, name, desc, false);
+                        if (r == T_JDK) {
+                            counts[K_WAIT]++;
+                            super.visitMethodInsn(Opcodes.INVOKESTATIC, DISC_TIME, "waitOn",
+                                                  j1 ? "(Ljava/lang/Object;J)V" : "(Ljava/lang/Object;JI)V", false);
+                            return;
+                        }
+                        count(counts, r);
+                    } else if (name.equals("join")) {
+                        int r = cls.resolve(owner, name, desc, true);
+                        if (r == T_JDK) {
+                            counts[K_JOIN]++;
+                            super.visitMethodInsn(Opcodes.INVOKESTATIC, DISC_TIME, "joinOn",
+                                                  j1 ? "(Ljava/lang/Thread;J)V" : "(Ljava/lang/Thread;JI)V", false);
+                            return;
+                        }
+                        count(counts, r);
+                    }
+                }
+            }
+
+            super.visitMethodInsn(opcode, owner, name, desc, itf);
+        }
+
+        private static void count(int[] counts, int r) {
+            if (r == T_OVERRIDE)
+                counts[K_KEPT_OVERRIDE]++;
+            else if (r == T_UNRESOLVED)
+                counts[K_KEPT_UNRESOLVED]++;
+        }
+    }
+
+    /*
+     * call target resolution
+     */
+    static final int T_JDK        = 0;  /* the JDK method: rewrite */
+    static final int T_OTHER      = 1;  /* not a Thread-chain owner */
+    static final int T_OVERRIDE   = 2;  /* a disc class declares name+desc */
+    static final int T_UNRESOLVED = 3;
+
+    private static final int MAX_DEPTH = 64;
+
+    static int resolveTarget(Resolver resolver, String owner, String name, String desc, boolean needThread) {
+        String c = owner;
+        for (int depth = 0; depth < MAX_DEPTH; depth++) {
+            if (c == null || c.equals("java/lang/Object") || c.startsWith("["))
+                return needThread ? T_OTHER : T_JDK;
+            if (c.equals("java/lang/Thread"))
+                return T_JDK;
+
+            ClassInfo info = resolver.jarClass(c);
+            if (info != null) {
+                if (info.declares(name, desc))
+                    return T_OVERRIDE;
+                c = info.superName;
+                continue;
+            }
+
+            Class k = resolver.outerClass(c);
+            if (k == null)
+                return T_UNRESOLVED;
+            if (!needThread)
+                return T_JDK;
+            return Thread.class.isAssignableFrom(k) ? T_JDK : T_OTHER;
+        }
+        return T_UNRESOLVED;
+    }
+
+    /*
+     * constant pool pre-scan
+     */
+    private static final class PoolScan {
+        boolean timeNames;     /* a name the call rewrites look for */
+        boolean namesTimer;    /* java/util/Timer or TimerTask anywhere (class, descriptor, signature) */
+        boolean reflectTimer;  /* "java.util.Timer" (dotted) */
+
+        static PoolScan scan(byte[] b) {
+            try {
+                PoolScan s = new PoolScan();
+                int count = u2(b, 8);
+                int p = 10;
+                for (int i = 1; i < count; i++) {
+                    int tag = b[p] & 0xff;
+                    switch (tag) {
+                    case 1: { /* Utf8 */
+                        int len = u2(b, p + 1);
+                        s.check(b, p + 3, len);
+                        p += 3 + len;
+                        break;
+                    }
+                    case 3: case 4: case 9: case 10: case 11: case 12: case 18:
+                        p += 5;
+                        break;
+                    case 5: case 6:
+                        p += 9;
+                        i++;
+                        break;
+                    case 7: case 8: case 16:
+                        p += 3;
+                        break;
+                    case 15:
+                        p += 4;
+                        break;
+                    default:
+                        return null;
+                    }
+                    if (p > b.length)
+                        return null;
+                }
+                return s;
+            } catch (ArrayIndexOutOfBoundsException e) {
+                return null;
+            }
+        }
+
+        private static int u2(byte[] b, int p) {
+            return ((b[p] & 0xff) << 8) | (b[p + 1] & 0xff);
+        }
+
+        private void check(byte[] b, int p, int len) {
+            if (equalsAscii(b, p, len, "currentTimeMillis") || equalsAscii(b, p, len, "nanoTime") ||
+                equalsAscii(b, p, len, "sleep") || equalsAscii(b, p, len, "wait") ||
+                equalsAscii(b, p, len, "join"))
+                timeNames = true;
+            if (indexOf(b, p, len, "java/util/Timer") >= 0)
+                namesTimer = true;
+            if (indexOf(b, p, len, "java.util.Timer") >= 0)
+                reflectTimer = true;
+        }
+    }
+
+    private static boolean equalsAscii(byte[] b, int p, int len, String s) {
+        if (len != s.length())
+            return false;
+        for (int i = 0; i < len; i++)
+            if (b[p + i] != (byte)s.charAt(i))
+                return false;
+        return true;
+    }
+
+    private static int indexOf(byte[] b, int p, int len, String s) {
+        int n = s.length();
+        for (int i = 0; i + n <= len; i++) {
+            int j = 0;
+            while (j < n && b[p + i + j] == (byte)s.charAt(j))
+                j++;
+            if (j == n)
+                return i;
+        }
+        return -1;
+    }
+
+    static boolean rawContains(byte[] b, String s) {
+        return indexOf(b, 0, b.length, s) >= 0;
+    }
+}
